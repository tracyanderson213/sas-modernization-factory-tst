{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.local/schemas/migration-source-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload_id", "subject_id", "source_closure_digest", "workload_configuration_digest", "workload_configuration_byte_count", "eligible_entry_points", "source_inventory"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "workload_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "source_closure_digest": {"$ref": "#/$defs/digest"},
    "workload_configuration_digest": {"$ref": "#/$defs/digest"},
    "workload_configuration_byte_count": {"type": "integer", "minimum": 1},
    "eligible_entry_points": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["entry_point_id", "path", "byte_count", "sha256", "device", "inode"], "properties": {"entry_point_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "byte_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}, "device": {"type": "string", "pattern": "^[0-9]+$"}, "inode": {"type": "string", "pattern": "^[0-9]+$"}}}},
    "source_inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "byte_count", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "byte_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/digest"}}}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
