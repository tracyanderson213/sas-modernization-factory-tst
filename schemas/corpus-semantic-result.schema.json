{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.local/schemas/corpus-semantic-result.schema.json",
  "title": "SMF Canonical Semantic Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "columns", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "logical_type", "nullable"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "logical_type": {"type": "string", "enum": ["character", "numeric", "date", "datetime", "time", "boolean"]},
          "nullable": {"type": "boolean"},
          "length": {"type": "integer", "minimum": 1}
        }
      }
    },
    "ordering_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "formatted_rows": {
      "description": "Optional formatted projection, positionally aligned with rows and columns.",
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "oneOf": [
            {"type": "string", "pattern": ".*\\S.*"},
            {"type": "boolean"},
            {"type": "object", "additionalProperties": false, "required": ["number"], "properties": {"number": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"}}},
            {"type": "object", "additionalProperties": false, "required": ["missing"], "properties": {"missing": {"type": "string", "pattern": "^(character|\\.|\\._|\\.[A-Z])$"}}}
          ]
        }
      }
    }
  }
}
