{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SMF SAS Temporal Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "date_epoch", "date_unit", "datetime_epoch", "datetime_unit", "calendar", "minimum_date", "maximum_date", "maximum_fractional_digits", "precision_mode", "source_timezone", "target_timezone", "date_format_projection", "datetime_format_projection", "supported_targets", "unsupported_cases"],
  "properties": {
    "policy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "date_epoch": {"const": "1960-01-01"},
    "date_unit": {"const": "days"},
    "datetime_epoch": {"const": "1960-01-01T00:00:00"},
    "datetime_unit": {"const": "seconds"},
    "calendar": {"const": "proleptic-gregorian"},
    "minimum_date": {"type": "string", "format": "date"},
    "maximum_date": {"type": "string", "format": "date"},
    "maximum_fractional_digits": {"const": 6},
    "precision_mode": {"const": "preserve-exact"},
    "source_timezone": {"const": "UTC"},
    "target_timezone": {"const": "UTC"},
    "date_format_projection": {"const": "DATE9."},
    "datetime_format_projection": {"const": "ISO8601-6"},
    "supported_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sparksql", "pyspark"]}},
    "unsupported_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
