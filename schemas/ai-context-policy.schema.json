{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/ai-context-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "policy_digest", "status", "classification_policy_id", "classification_policy_version", "classification_policy_digest", "classification_authority", "verification_keys", "providers", "allowed_artifact_kinds", "allowed_fields", "retention_policy_ref", "access_policy_ref", "protected_data_in_prompt_allowed", "max_context_bytes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}, "policy_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["active", "pending", "denied"]},
    "classification_policy_id": {"$ref": "#/$defs/id"}, "classification_policy_version": {"$ref": "#/$defs/id"}, "classification_policy_digest": {"$ref": "#/$defs/digest"}, "classification_authority": {"$ref": "#/$defs/id"},
    "verification_keys": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "providers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_id", "model_ids", "endpoint_binding_ids"], "properties": {"provider_id": {"$ref": "#/$defs/id"}, "model_ids": {"$ref": "#/$defs/ids"}, "endpoint_binding_ids": {"$ref": "#/$defs/ids"}}}},
    "allowed_artifact_kinds": {"$ref": "#/$defs/ids"}, "allowed_fields": {"$ref": "#/$defs/ids"},
    "retention_policy_ref": {"$ref": "#/$defs/id"}, "access_policy_ref": {"$ref": "#/$defs/id"},
    "protected_data_in_prompt_allowed": {"const": false},
    "max_context_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
