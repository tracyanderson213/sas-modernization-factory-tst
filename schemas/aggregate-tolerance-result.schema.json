{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.smf.example/aggregate-tolerance-result.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","result_id","request","request_digest","policy","policy_digest","status","checks","claims","content_digest"],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "observation":{"type":"object","additionalProperties":false,"required":["group","value","null_count"],"properties":{"group":{"type":"object","minProperties":1,"additionalProperties":{"type":"string"}},"value":{"type":["string","null"],"pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},"null_count":{"type":"integer","minimum":0}}},
    "request":{"type":"object","additionalProperties":false,"required":["client_id","workload_id","source_id","run_id","attempt_id","source_snapshot_digest","target_snapshot_digest","source","target"],"properties":{"client_id":{"type":"string","minLength":1},"workload_id":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"source_snapshot_digest":{"$ref":"#/$defs/digest"},"target_snapshot_digest":{"$ref":"#/$defs/digest"},"source":{"type":"array","items":{"$ref":"#/$defs/observation"}},"target":{"type":"array","items":{"$ref":"#/$defs/observation"}}}},
    "policy":{"type":"object","additionalProperties":false,"required":["schema_version","policy_id","policy_version","measure_id","group_keys","absolute_tolerance","relative_tolerance","maximum_absolute_value","relative_denominator","null_rule"],"properties":{"schema_version":{"const":"1.0"},"policy_id":{"type":"string","minLength":1},"policy_version":{"type":"string","minLength":1},"measure_id":{"type":"string","minLength":1},"group_keys":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"absolute_tolerance":{"type":"string"},"relative_tolerance":{"type":"string"},"maximum_absolute_value":{"type":"string"},"relative_denominator":{"const":"source_absolute"},"null_rule":{"const":"both_null_only"}}},
    "check":{"type":"object","additionalProperties":false,"required":["group","status","reason","difference","permitted_difference"],"properties":{"group":{"type":"object","minProperties":1,"additionalProperties":{"type":"string"}},"status":{"enum":["passed","failed","blocked"]},"reason":{"enum":["missing_group","null_count_mismatch","null_semantics_mismatch","both_null","overflow_bound_exceeded","within_tolerance","outside_tolerance"]},"difference":{"type":["string","null"]},"permitted_difference":{"type":["string","null"]}}}
  },
  "properties":{"schema_version":{"const":"1.0"},"result_id":{"$ref":"#/$defs/digest"},"request":{"$ref":"#/$defs/request"},"request_digest":{"$ref":"#/$defs/digest"},"policy":{"$ref":"#/$defs/policy"},"policy_digest":{"$ref":"#/$defs/digest"},"status":{"enum":["passed","failed","blocked"]},"checks":{"type":"array","items":{"$ref":"#/$defs/check"}},"claims":{"type":"object","additionalProperties":false,"required":["aggregate_check_passed","data_parity_passed","certified","humana_validated"],"properties":{"aggregate_check_passed":{"type":"boolean"},"data_parity_passed":{"const":false},"certified":{"const":false},"humana_validated":{"const":false}}},"content_digest":{"$ref":"#/$defs/digest"}}
}
