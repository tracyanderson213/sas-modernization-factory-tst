{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_id", "batch_id", "batch_version", "expected_script_count", "authority", "artifacts", "workloads", "unprocessable", "manifest_digest", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "client_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "batch_version": {"type": "string", "minLength": 1},
    "expected_script_count": {"type": "integer", "minimum": 1},
    "authority": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "workloads": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workload"}},
    "unprocessable": {"type": "array", "items": {"$ref": "#/$defs/unprocessable"}},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["script_id", "alias", "logical_path", "source_uri", "kind", "sha256", "size_bytes"],
      "properties": {
        "script_id": {"type": "string", "minLength": 1}, "alias": {"type": "string", "minLength": 1},
        "logical_path": {"type": "string", "minLength": 1}, "source_uri": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["alias", "script_ids", "entrypoint_ids", "closure_ids"],
      "properties": {"alias": {"type": "string", "minLength": 1}, "script_ids": {"$ref": "#/$defs/stringList"}, "entrypoint_ids": {"$ref": "#/$defs/stringList"}, "closure_ids": {"$ref": "#/$defs/stringList"}}
    },
    "unprocessable": {
      "type": "object", "additionalProperties": false,
      "required": ["script_id", "reason_code", "owner"],
      "properties": {"script_id": {"type": "string", "minLength": 1}, "reason_code": {"type": "string", "enum": ["missing_source", "unsupported_encoding", "owner_excluded", "not_sas"]}, "owner": {"type": "string", "minLength": 1}}
    },
    "proof": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"],
      "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
    }
  }
}
