{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.local/schemas/corpus-golden-comparison.schema.json",
  "title": "SMF Golden Conversion Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "comparison_id", "qualification_id", "scenario_id",
    "workload_id", "subject_id", "run_id", "attempt_id", "source_digest",
    "bundle_digest", "policy_digest", "golden_contract_digest", "golden_id",
    "golden_version", "comparison_mode", "provider_id", "provider_version",
    "strategy_id", "strategy_version", "producer_stage_id", "producer_plan_id",
    "behavioral_expectation_id", "behavioral_evidence_digest",
    "expected_disposition", "actual_disposition", "expected_sha256",
    "actual_sha256", "expected_size_bytes", "actual_size_bytes", "outcome",
    "mismatch_category", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_id": {"$ref": "#/$defs/id"},
    "qualification_id": {"$ref": "#/$defs/id"},
    "scenario_id": {"$ref": "#/$defs/id"},
    "workload_id": {"$ref": "#/$defs/id"},
    "subject_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "source_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "golden_contract_digest": {"$ref": "#/$defs/digest"},
    "golden_id": {"$ref": "#/$defs/id"},
    "golden_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "comparison_mode": {"const": "exact-bytes"},
    "provider_id": {"$ref": "#/$defs/id"},
    "provider_version": {"$ref": "#/$defs/id"},
    "strategy_id": {"$ref": "#/$defs/id"},
    "strategy_version": {"$ref": "#/$defs/id"},
    "producer_stage_id": {"$ref": "#/$defs/id"},
    "producer_plan_id": {"$ref": "#/$defs/id"},
    "behavioral_expectation_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "behavioral_evidence_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "expected_disposition": {"enum": ["generated", "unsupported", "human_pending"]},
    "actual_disposition": {"enum": ["generated", "unsupported", "human_pending", "blocked", "failed"]},
    "expected_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "actual_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "expected_size_bytes": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "actual_size_bytes": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
    "outcome": {"enum": ["matched", "mismatched"]},
    "mismatch_category": {"enum": ["none", "disposition", "provider", "artifact-count", "content", "conversion-evidence", "behavioral-evidence"]},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
