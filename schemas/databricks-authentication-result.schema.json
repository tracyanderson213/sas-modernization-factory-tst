{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SMF Databricks Authentication Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request", "request_digest", "authentication_request_id",
    "authentication_attempt_id", "decision_id", "state", "reason_code",
    "transport_attempted", "workspace_verified", "identity_verified",
    "permissions_verified", "provider_request_id", "elapsed_ms", "retryable",
    "evidence_refs", "generated", "authenticated", "submitted", "executed",
    "validated", "parity_passed", "human_assisted", "blocked", "certified",
    "human_approved", "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request": {"$ref": "databricks-authentication-request.schema.json"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authentication_request_id": {"type": "string", "pattern": "^dba-[0-9a-f]{64}$"},
    "authentication_attempt_id": {"type": "string"},
    "decision_id": {"type": "string", "pattern": "^dbd-[0-9a-f]{64}$"},
    "state": {"enum": ["verified", "blocked_missing", "blocked_pending", "denied", "expired", "invalid_binding", "wrong_workspace", "wrong_identity", "permission_denied", "unsupported", "provider_unavailable", "timed_out", "cancelled", "failed", "outcome_unknown"]},
    "reason_code": {"type": "string", "minLength": 1},
    "transport_attempted": {"type": "boolean"},
    "workspace_verified": {"type": "boolean"},
    "identity_verified": {"type": "boolean"},
    "permissions_verified": {"type": "boolean"},
    "provider_request_id": {"type": ["string", "null"]},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "retryable": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "generated": {"const": true},
    "authenticated": {"type": "boolean"},
    "submitted": {"const": false},
    "executed": {"const": false},
    "validated": {"const": false},
    "parity_passed": {"const": false},
    "human_assisted": {"type": "boolean"},
    "blocked": {"type": "boolean"},
    "certified": {"const": false},
    "human_approved": {"const": false},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
