{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "client_id", "inventory_id", "inventory_version", "inventory_digest", "authority", "proof", "run_id", "attempt_id", "expected_competition_denominator", "observed_unique_script_denominator", "discovery_snapshot", "candidates", "unprocessable"],
  "properties": {
    "schema_version": {"const": "1.0"}, "client_id": {"$ref": "#/$defs/id"}, "inventory_id": {"$ref": "#/$defs/id"}, "inventory_version": {"$ref": "#/$defs/id"}, "inventory_digest": {"$ref": "#/$defs/digest"}, "authority": {"$ref": "#/$defs/id"}, "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 40, "maxLength": 128}}}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "expected_competition_denominator": {"type": "integer", "minimum": 1}, "observed_unique_script_denominator": {"type": "integer", "minimum": 1},
    "discovery_snapshot": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "uri", "digest", "content_digest", "authority", "acquisition_id"], "properties": {"snapshot_id": {"$ref": "#/$defs/id"}, "uri": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}, "content_digest": {"$ref": "#/$defs/digest"}, "authority": {"$ref": "#/$defs/id"}, "acquisition_id": {"$ref": "#/$defs/id"}}},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/candidate"}},
    "unprocessable": {"type": "array", "maxItems": 100000, "items": {"type": "object", "additionalProperties": false, "required": ["record_id", "script_ids", "reason", "owner"], "properties": {"record_id": {"$ref": "#/$defs/id"}, "script_ids": {"$ref": "#/$defs/scripts"}, "reason": {"$ref": "#/$defs/id"}, "owner": {"$ref": "#/$defs/id"}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "minLength": 1, "maxLength": 512},
    "ids": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "scripts": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "logical_path", "source_uri", "sha256", "size_bytes"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "logical_path": {"$ref": "#/$defs/path"}, "source_uri": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["prerequisite_id", "state", "owner", "evidence_run_id", "evidence_attempt_id", "readiness_manifest_uri", "readiness_manifest_digest"], "properties": {"prerequisite_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["passed", "missing", "pending", "denied", "expired", "failed"]}, "owner": {"$ref": "#/$defs/id"}, "evidence_run_id": {"type": ["string", "null"]}, "evidence_attempt_id": {"type": ["string", "null"]}, "readiness_manifest_uri": {"type": ["string", "null"]}, "readiness_manifest_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["workload_id", "boundary_id", "script_ids", "entry_point_artifact_id", "source_closure", "source_closure_digest", "closure_evidence_artifact_ids", "discovery_workload_digest", "assessment", "complexity", "complexity_score", "constructs", "macro_behaviors", "dependency_characteristics", "coupling_group", "data_access_categories", "validation_difficulty", "validation_policy_ref", "prerequisites", "source_origin"], "properties": {
      "workload_id": {"$ref": "#/$defs/id"}, "boundary_id": {"$ref": "#/$defs/id"}, "script_ids": {"$ref": "#/$defs/scripts"}, "entry_point_artifact_id": {"$ref": "#/$defs/id"},
      "source_closure": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}}, "source_closure_digest": {"$ref": "#/$defs/digest"}, "closure_evidence_artifact_ids": {"$ref": "#/$defs/ids"}, "discovery_workload_digest": {"$ref": "#/$defs/digest"},
      "assessment": {"type": "object", "additionalProperties": false, "required": ["assessment_id", "strategy_id", "strategy_version", "uri", "digest", "result_digest", "policy_uri", "policy_digest"], "properties": {"assessment_id": {"$ref": "#/$defs/id"}, "strategy_id": {"$ref": "#/$defs/id"}, "strategy_version": {"$ref": "#/$defs/id"}, "uri": {"$ref": "#/$defs/path"}, "digest": {"$ref": "#/$defs/digest"}, "result_digest": {"$ref": "#/$defs/digest"}, "policy_uri": {"$ref": "#/$defs/path"}, "policy_digest": {"$ref": "#/$defs/digest"}}},
      "complexity": {"enum": ["simple", "moderate", "complex", "unknown"]}, "complexity_score": {"type": "integer", "minimum": 0, "maximum": 100000}, "constructs": {"$ref": "#/$defs/ids"},
      "macro_behaviors": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "static", "dynamic", "external", "unresolved"]}},
      "dependency_characteristics": {"type": "array", "uniqueItems": true, "items": {"enum": ["isolated", "internal", "external", "scheduler", "unresolved", "cyclic"]}}, "coupling_group": {"type": ["string", "null"]},
      "data_access_categories": {"type": "array", "uniqueItems": true, "items": {"enum": ["none", "files", "database", "warehouse", "api", "protected", "unknown"]}},
      "validation_difficulty": {"enum": ["low", "medium", "high", "unknown"]}, "validation_policy_ref": {"$ref": "#/$defs/id"}, "prerequisites": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/prerequisite"}}, "source_origin": {"enum": ["private_client", "public", "synthetic", "workshop", "mock", "generated"]}
    }}
  }
}
