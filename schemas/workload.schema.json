{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sas-modernization-factory/schemas/workload.schema.json",
  "title": "SAS Modernization Factory Workload",
  "description": "Canonical representation of a SAS workload entering the modernization factory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workload_id",
    "name",
    "source_type",
    "source_files",
    "status"
  ],
  "properties": {
    "workload_id": {
      "type": "string",
      "pattern": "^SMF-[0-9]{6}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": ["sas"]
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type"],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sas_program",
              "macro",
              "include",
              "configuration",
              "other"
            ]
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": ["upstream", "downstream"]
          }
        }
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    },
    "owner": {
      "type": "string"
    },
    "business_criticality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "regulatory_classification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "ingested",
        "assessing",
        "assessed",
        "converting",
        "converted",
        "validating",
        "validation_failed",
        "validated",
        "human_review",
        "approved",
        "deployed",
        "failed"
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
