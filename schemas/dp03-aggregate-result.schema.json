    "binding":{"type":"object","additionalProperties":false,"required":["dataset_id","snapshot_id","snapshot_digest","scope_id","scope_digest"],"properties":{"dataset_id":{"$ref":"#/$defs/id"},"snapshot_id":{"$ref":"#/$defs/id"},"snapshot_digest":{"$ref":"#/$defs/digest"},"scope_id":{"$ref":"#/$defs/id"},"scope_digest":{"$ref":"#/$defs/digest"}}},
