{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "client_id", "provider", "provider_version", "discovery_strategy_version", "manifest_provenance", "verification_keys", "readiness_prerequisites"],
  "properties": {
    "schema_version": {"const": "1.0"}, "policy_id": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1}, "provider": {"enum": ["filesystem"]}, "provider_version": {"type": "string", "minLength": 1}, "discovery_strategy_version": {"type": "string", "minLength": 1},
    "manifest_provenance": {"type": "object", "additionalProperties": false, "required": ["authorities", "key_ids"], "properties": {"authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "verification_keys": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "readiness_prerequisites": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "owner"], "properties": {"kind": {"enum": ["sas_baseline", "target_snapshot", "dataset_mapping", "validation_policy", "environment_evidence"]}, "owner": {"type": "string", "minLength": 1}}}}
  }
}
