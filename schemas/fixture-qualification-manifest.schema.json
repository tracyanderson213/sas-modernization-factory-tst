{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_revision", "client_id", "workload_id", "source_digest", "run_id", "attempt_id", "collected_at", "evidence_class", "purpose", "fixtures", "prerequisites", "authority", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"}, "manifest_id": {"$ref": "#/$defs/id"}, "manifest_revision": {"type": "string", "minLength": 1}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "collected_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"enum": ["synthetic_contract", "real"]}, "purpose": {"enum": ["reader_evaluation", "regression", "customer_baseline"]},
    "fixtures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fixture"}}, "prerequisites": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/prerequisite"}}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._ /-]{0,255}$"},
    "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["prerequisite_id", "status", "result_digest", "client_id", "workload_id", "source_digest", "run_id", "attempt_id", "authority", "proof"], "properties": {"prerequisite_id": {"enum": ["UPQ-01", "LIC-01"]}, "status": {"enum": ["complete", "blocked", "pending", "denied", "failed"]}, "result_digest": {"$ref": "#/$defs/sha"}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["license_id", "evidence_digest", "status"], "properties": {"license_id": {"$ref": "#/$defs/id"}, "evidence_digest": {"$ref": "#/$defs/sha"}, "status": {"enum": ["verified", "pending", "denied", "ambiguous"]}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "logical_path", "media_type", "byte_count", "sha256", "producer", "producer_version", "sas_artifact", "sas_version", "source_revision", "asset_class", "permitted_purposes", "redistribution", "license", "provenance_digest", "authority"], "properties": {"fixture_id": {"$ref": "#/$defs/id"}, "logical_path": {"$ref": "#/$defs/path"}, "media_type": {"enum": ["application/x-sas-data", "application/x-sas-catalog", "application/x-sas-transport"]}, "byte_count": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha"}, "producer": {"type": "string", "minLength": 1}, "producer_version": {"type": "string", "minLength": 1}, "sas_artifact": {"enum": ["sas7bdat", "sas7bcat", "xpt"]}, "sas_version": {"type": ["string", "null"]}, "source_revision": {"type": "string", "minLength": 1}, "asset_class": {"enum": ["licensed", "evaluation_only", "customer_controlled", "prohibited"]}, "permitted_purposes": {"type": "array", "uniqueItems": true, "items": {"enum": ["reader_evaluation", "regression", "customer_baseline"]}}, "redistribution": {"enum": ["license_permitted", "evaluation_only", "customer_controlled", "prohibited"]}, "license": {"$ref": "#/$defs/license"}, "provenance_digest": {"$ref": "#/$defs/sha"}, "authority": {"$ref": "#/$defs/id"}}}
  }
}
