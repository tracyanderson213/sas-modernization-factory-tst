{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://smf.local/schemas/conversion-coverage-corpus.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","corpus_id","corpus_revision","description","subjects"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "corpus_id":{"$ref":"#/$defs/id"},
    "corpus_revision":{"$ref":"#/$defs/id"},
    "description":{"type":"string","minLength":1,"maxLength":512},
    "subjects":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/subject"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "relative":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"},
    "subject":{
      "type":"object","additionalProperties":false,
      "required":["subject_id","source_artifact_id","source_path","source_sha256","provenance_path","provenance_sha256","constructs","complexity","target"],
      "properties":{
        "subject_id":{"$ref":"#/$defs/id"},
        "source_artifact_id":{"$ref":"#/$defs/id"},
        "source_path":{"$ref":"#/$defs/relative"},
        "source_sha256":{"$ref":"#/$defs/sha"},
        "provenance_path":{"$ref":"#/$defs/relative"},
        "provenance_sha256":{"$ref":"#/$defs/sha"},
        "constructs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "complexity":{"enum":["low","medium","high","unknown"]},
        "target":{"enum":["pyspark","sparksql"]}
      }
    }
  }
}
