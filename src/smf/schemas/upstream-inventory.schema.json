{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "inventory_version", "source_report", "upstreams"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "inventory_version": {"$ref": "#/$defs/id"},
    "source_report": {"type": "string", "minLength": 1, "maxLength": 255},
    "upstreams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/upstream"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "disposition": {"enum": ["adopt_directly", "wrap", "reuse_transitively", "reuse_selected_licensed_components", "patterns_only", "reject", "fork_and_harden"]},
    "use": {"enum": ["runtime", "provider_wrapper", "transitive_dependency", "licensed_component", "evaluation_in_place", "public_corpus", "design_patterns", "dataframe_layer", "optional_quality_policy", "fixture_research", "none"]},
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_id", "canonical_origin", "revision", "revision_type", "artifact_class", "license_evidence", "capabilities", "limitations", "activity_source", "permitted_use", "disposition"],
      "properties": {
        "upstream_id": {"$ref": "#/$defs/id"},
        "canonical_origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "revision_type": {"enum": ["git_commit", "sha256"]},
        "artifact_class": {"enum": ["source_tree", "python_package", "native_library", "jvm_package", "runtime", "corpus", "research"]},
        "license_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "license_id"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "license_id": {"enum": ["Apache-2.0", "MIT", "BSD-3-Clause", "Unlicense", "Databricks-License", "NOASSERTION"]}}}},
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["capability_id", "description"], "properties": {"capability_id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1, "maxLength": 500}}}},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "description"], "properties": {"limitation_id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1, "maxLength": 500}}}},
        "activity_source": {"type": "string", "format": "uri", "pattern": "^https://"},
        "permitted_use": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/use"}},
        "disposition": {"$ref": "#/$defs/disposition"}
      }
    }
  }
}
