{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "columns", "sampling", "receipt_authorities"],
  "properties": {
    "schema_version": {"const": "1.0"}, "policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"},
    "columns": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["name", "kind", "numeric_bins", "categories", "absolute_tolerance", "relative_tolerance"], "properties": {"name": {"$ref": "#/$defs/id"}, "kind": {"enum": ["numeric", "categorical"]}, "numeric_bins": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/decimal"}}, "categories": {"type": "array", "maxItems": 512, "items": {"type": "string", "maxLength": 256}}, "absolute_tolerance": {"$ref": "#/$defs/decimal"}, "relative_tolerance": {"$ref": "#/$defs/decimal"}}}},
    "sampling": {"type": "object", "additionalProperties": false, "required": ["method", "fraction", "seed", "key_columns"], "properties": {"method": {"enum": ["exact", "deterministic_hash"]}, "fraction": {"$ref": "#/$defs/decimal"}, "seed": {"$ref": "#/$defs/id"}, "key_columns": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "receipt_authorities": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["side", "authority_id", "key_id", "provider_id", "provider_version", "evidence_class", "public_key"], "properties": {"side": {"enum": ["source", "target"]}, "authority_id": {"$ref": "#/$defs/id"}, "key_id": {"$ref": "#/$defs/id"}, "provider_id": {"type": "string", "minLength": 1, "maxLength": 256}, "provider_version": {"type": "string", "minLength": 1, "maxLength": 256}, "evidence_class": {"const": "synthetic_contract"}, "public_key": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}}
}
