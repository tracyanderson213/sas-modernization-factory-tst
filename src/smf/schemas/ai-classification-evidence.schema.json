{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/ai-classification-evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "state", "authority", "purpose", "decision_id", "owner_assignment_ref", "issued_at", "expires_at", "bindings", "artifacts", "fields", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"}, "evidence_id": {"$ref": "#/$defs/id"},
    "state": {"enum": ["approved", "pending", "denied"]}, "authority": {"$ref": "#/$defs/id"},
    "purpose": {"const": "offline_ai_context_qualification"}, "decision_id": {"$ref": "#/$defs/id"}, "owner_assignment_ref": {"$ref": "#/$defs/id"},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256", "classification"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}, "classification": {"enum": ["non_protected", "protected", "ambiguous", "unclassified"]}}}},
    "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["field_id", "classification"], "properties": {"field_id": {"$ref": "#/$defs/id"}, "classification": {"enum": ["permitted", "denied", "ambiguous", "unclassified"]}}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "client_id", "deployment_id", "environment_id", "workload_id", "workload_digest", "boundary_id", "subject_id", "source_closure_digest", "run_id", "attempt_id", "consumer_id", "consumer_contract_version", "strategy_version", "readiness_result_id", "readiness_manifest_digest", "context_policy_id", "context_policy_version", "context_policy_digest", "classification_policy_id", "classification_policy_version", "classification_policy_digest", "provider_id", "model_id", "endpoint_binding_id", "retention_policy_ref", "access_policy_ref", "requested_artifact_ids", "requested_fields", "decision_purpose"],
      "properties": {
        "schema_version": {"const": "1.0"}, "client_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "environment_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "workload_digest": {"$ref": "#/$defs/digest"}, "boundary_id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "source_closure_digest": {"$ref": "#/$defs/digest"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "consumer_id": {"$ref": "#/$defs/id"}, "consumer_contract_version": {"$ref": "#/$defs/id"}, "strategy_version": {"$ref": "#/$defs/id"}, "readiness_result_id": {"$ref": "#/$defs/id"}, "readiness_manifest_digest": {"$ref": "#/$defs/digest"}, "context_policy_id": {"$ref": "#/$defs/id"}, "context_policy_version": {"$ref": "#/$defs/id"}, "context_policy_digest": {"$ref": "#/$defs/digest"}, "classification_policy_id": {"$ref": "#/$defs/id"}, "classification_policy_version": {"$ref": "#/$defs/id"}, "classification_policy_digest": {"$ref": "#/$defs/digest"}, "provider_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"}, "endpoint_binding_id": {"$ref": "#/$defs/id"}, "retention_policy_ref": {"$ref": "#/$defs/id"}, "access_policy_ref": {"$ref": "#/$defs/id"}, "requested_artifact_ids": {"$ref": "#/$defs/ids"}, "requested_fields": {"$ref": "#/$defs/ids"}, "decision_purpose": {"const": "offline_ai_context_qualification"}
      }
    }
  }
}
