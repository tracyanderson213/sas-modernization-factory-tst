{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "chain_id", "content_digest", "client_id", "workload_id",
    "source_revision_id", "run_id", "attempt_id", "lineage_id", "lineage_ref",
    "lineage_sha256", "policy_id", "policy_version", "policy_digest", "required_stages",
    "nodes", "active_node_ids", "missing_stages", "terminal_disposition", "telemetry",
    "authorizes_execution", "authorizes_approval", "authorizes_certification"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "chain_id": {"type": "string", "pattern": "^PC-v1-[a-f0-9]{64}$"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "client_id": {"$ref": "#/$defs/safe"},
    "workload_id": {"type": "string", "pattern": "^WL-v1-[a-f0-9]{64}$"},
    "source_revision_id": {"type": "string", "pattern": "^SRC-v1-[a-f0-9]{64}$"},
    "run_id": {"type": "string", "pattern": "^RUN-v1-[a-f0-9]{64}$"},
    "attempt_id": {"type": "string", "pattern": "^ATT-v1-[a-f0-9]{64}$"},
    "lineage_id": {"type": "string", "pattern": "^LIN-v1-[a-f0-9]{64}$"},
    "lineage_ref": {"$ref": "#/$defs/ref"},
    "lineage_sha256": {"$ref": "#/$defs/digest"},
    "policy_id": {"$ref": "#/$defs/safe"},
    "policy_version": {"$ref": "#/$defs/safe"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "required_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nodeType"}},
    "nodes": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "node_ref", "node_sha256"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^PN-v1-[a-f0-9]{64}$"},
          "node_ref": {"$ref": "#/$defs/ref"},
          "node_sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "active_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^PN-v1-[a-f0-9]{64}$"}},
    "missing_stages": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nodeType"}},
    "terminal_disposition": {"enum": ["validated", "failed", "blocked_missing", "blocked_unresolved", "human_pending", "human_denied", "unsupported", "cancelled"]},
    "telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["generated", "executed", "validated", "parity_passed", "human_assisted", "human_approved", "certified", "blocked"],
      "properties": {
        "generated": {"type": "boolean"}, "executed": {"type": "boolean"},
        "validated": {"type": "boolean"}, "parity_passed": {"const": false},
        "human_assisted": {"type": "boolean"}, "human_approved": {"type": "boolean"},
        "certified": {"const": false}, "blocked": {"type": "boolean"}
      }
    },
    "authorizes_execution": {"const": false},
    "authorizes_approval": {"const": false},
    "authorizes_certification": {"const": false}
  },
  "$defs": {
    "safe": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+\\-]{0,255}$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/).+$"},
    "nodeType": {"enum": ["source_intake", "strategy", "conversion", "generated_artifact", "execution", "validation", "repair", "human_decision"]}
  }
}
