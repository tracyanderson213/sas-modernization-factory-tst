{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "result_id", "client_id", "workload_id", "source_digest", "run_id", "attempt_id", "policy_digest", "manifest_digest", "evaluated_at", "evidence_class", "purpose", "outcome", "blockers", "decisions", "claims", "evaluator_authority", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"}, "contract_version": {"const": "smf-corpus-fixture-qualification-v1"}, "result_id": {"$ref": "#/$defs/id"}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "policy_digest": {"$ref": "#/$defs/sha"}, "manifest_digest": {"$ref": "#/$defs/sha"}, "evaluated_at": {"type": "string", "format": "date-time"}, "evidence_class": {"enum": ["synthetic_contract", "real"]}, "purpose": {"enum": ["reader_evaluation", "regression", "customer_baseline"]}, "outcome": {"enum": ["qualified_contract", "blocked", "denied", "incompatible", "stale"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "asset_class", "outcome", "blockers", "fixture_digest"], "properties": {"fixture_id": {"$ref": "#/$defs/id"}, "asset_class": {"enum": ["licensed", "evaluation_only", "customer_controlled", "prohibited"]}, "outcome": {"enum": ["qualified_contract", "blocked", "denied", "incompatible"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fixture_digest": {"$ref": "#/$defs/sha"}}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["customer_access_authorized", "redistribution_authorized", "migration_executed", "reader_validated", "parity_established", "production_ready"], "properties": {"customer_access_authorized": {"const": false}, "redistribution_authorized": {"const": false}, "migration_executed": {"const": false}, "reader_validated": {"const": false}, "parity_established": {"const": false}, "production_ready": {"const": false}}}, "evaluator_authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}}}
}
