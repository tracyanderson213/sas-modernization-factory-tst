{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "acquisition_id", "client_id", "workload_id", "workload_revision_id", "workload_digest", "closure_digest", "boundary_id", "run_id", "attempt_id", "acquisition_policy_digest", "producer_authority", "provider", "provider_version", "format", "source_closure", "input_snapshots", "execution", "executed_at", "exported_at", "outputs", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_id": {"$ref": "#/$defs/id"}, "acquisition_id": {"$ref": "#/$defs/id"}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "workload_revision_id": {"$ref": "#/$defs/id"}, "workload_digest": {"$ref": "#/$defs/sha"}, "closure_digest": {"$ref": "#/$defs/sha"}, "boundary_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "acquisition_policy_digest": {"$ref": "#/$defs/sha"},
    "producer_authority": {"$ref": "#/$defs/id"}, "provider": {"const": "approved_export"}, "provider_version": {"$ref": "#/$defs/id"}, "format": {"enum": ["csv", "json", "parquet", "sas7bdat"]},
    "source_closure": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "input_snapshots": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "execution": {"$ref": "#/$defs/execution"},
    "executed_at": {"type": "string", "format": "date-time"}, "exported_at": {"type": "string", "format": "date-time"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}},
    "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["script_id", "logical_path", "sha256", "byte_count"], "properties": {"script_id": {"$ref": "#/$defs/id"}, "logical_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "byte_count": {"type": "integer", "minimum": 1}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "snapshot_id", "snapshot_uri", "artifact_digest", "schema_digest"], "properties": {"dataset_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/id"}, "snapshot_uri": {"type": "string", "pattern": "^evidence://[A-Za-z0-9._/-]+$"}, "artifact_digest": {"$ref": "#/$defs/sha"}, "schema_digest": {"$ref": "#/$defs/sha"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["sas_execution_id", "environment_id", "sas_product", "sas_release", "runtime_configuration_digest", "executed_at"], "properties": {"sas_execution_id": {"$ref": "#/$defs/id"}, "environment_id": {"$ref": "#/$defs/id"}, "sas_product": {"type": "string", "minLength": 1}, "sas_release": {"type": "string", "minLength": 1}, "runtime_configuration_digest": {"$ref": "#/$defs/sha"}, "executed_at": {"type": "string", "format": "date-time"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["output_id", "dataset_id", "logical_name", "format", "artifact_path", "byte_count", "content_digest", "schema_digest", "normalization_version", "origin", "status"], "properties": {"output_id": {"$ref": "#/$defs/id"}, "dataset_id": {"$ref": "#/$defs/id"}, "logical_name": {"$ref": "#/$defs/id"}, "format": {"enum": ["csv", "json", "parquet", "sas7bdat"]}, "artifact_path": {"type": "string", "minLength": 1}, "byte_count": {"type": "integer", "minimum": 1}, "content_digest": {"$ref": "#/$defs/sha"}, "schema_digest": {"$ref": "#/$defs/sha"}, "normalization_version": {"$ref": "#/$defs/id"}, "origin": {"const": "sas_execution"}, "status": {"const": "completed"}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}}
  }
}
