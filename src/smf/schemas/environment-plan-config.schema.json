{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/environment-plan-config.schema.json",
  "title": "SMF strict offline environment contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "deployment_identity", "workspace", "unity_catalog", "volumes", "compute", "git", "vault", "ai_gateway", "packages", "sources", "probe_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["internal_provision", "customer_validate"]},
    "deployment_identity": {"$ref": "#/$defs/identity"},
    "workspace": {"type": "object", "additionalProperties": false, "required": ["state", "host_reference", "workspace_reference", "auth_context_reference", "auth_method", "principal_reference"], "properties": {"state": {"$ref": "#/$defs/state"}, "host_reference": {"$ref": "#/$defs/nullableReference"}, "workspace_reference": {"$ref": "#/$defs/nullableReference"}, "auth_context_reference": {"$ref": "#/$defs/nullableReference"}, "auth_method": {"enum": ["entra_workload_identity", "entra_service_principal", "pending"]}, "principal_reference": {"$ref": "#/$defs/nullableReference"}}},
    "unity_catalog": {"type": "object", "additionalProperties": false, "required": ["state", "catalog_reference", "logical_schemas"], "properties": {"state": {"$ref": "#/$defs/state"}, "catalog_reference": {"$ref": "#/$defs/nullableReference"}, "logical_schemas": {"type": "object", "additionalProperties": false, "required": ["source", "discovery", "conversion", "validation", "evidence", "operations"], "properties": {"source": {"$ref": "#/$defs/nullableReference"}, "discovery": {"$ref": "#/$defs/nullableReference"}, "conversion": {"$ref": "#/$defs/nullableReference"}, "validation": {"$ref": "#/$defs/nullableReference"}, "evidence": {"$ref": "#/$defs/nullableReference"}, "operations": {"$ref": "#/$defs/nullableReference"}}}}},
    "volumes": {"type": "object", "additionalProperties": false, "required": ["state", "landing", "artifact", "validation", "checkpoint"], "properties": {"state": {"$ref": "#/$defs/state"}, "landing": {"$ref": "#/$defs/nullableReference"}, "artifact": {"$ref": "#/$defs/nullableReference"}, "validation": {"$ref": "#/$defs/nullableReference"}, "checkpoint": {"$ref": "#/$defs/nullableReference"}}},
    "compute": {
      "type": "object", "additionalProperties": false, "required": ["state", "selection", "existing_compute_reference", "governed_request"],
      "properties": {"state": {"$ref": "#/$defs/state"}, "selection": {"enum": ["pending", "existing", "governed_request"]}, "existing_compute_reference": {"$ref": "#/$defs/nullableReference"}, "governed_request": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["compute_policy_reference", "runtime_reference", "node_type_reference"], "properties": {"compute_policy_reference": {"$ref": "#/$defs/nullableReference"}, "runtime_reference": {"$ref": "#/$defs/nullableReference"}, "node_type_reference": {"$ref": "#/$defs/nullableReference"}}}]}},
      "allOf": [
        {"if": {"properties": {"selection": {"const": "pending"}}}, "then": {"properties": {"existing_compute_reference": {"type": "null"}, "governed_request": {"type": "null"}}}},
        {"if": {"properties": {"selection": {"const": "existing"}}}, "then": {"properties": {"existing_compute_reference": {"type": "string"}, "governed_request": {"type": "null"}}}},
        {"if": {"properties": {"selection": {"const": "governed_request"}}}, "then": {"properties": {"existing_compute_reference": {"type": "null"}, "governed_request": {"type": "object"}}}}
      ]
    },
    "git": {"type": "object", "additionalProperties": false, "required": ["state", "repository_reference"], "properties": {"state": {"$ref": "#/$defs/state"}, "repository_reference": {"$ref": "#/$defs/nullableReference"}}},
    "vault": {"type": "object", "additionalProperties": false, "required": ["state", "provider", "origin_reference", "vault_reference", "namespace_reference", "mount_reference", "auth_method", "audience_reference", "role_reference", "secret_binding_references"], "properties": {"state": {"$ref": "#/$defs/state"}, "provider": {"const": "hashicorp_vault"}, "origin_reference": {"$ref": "#/$defs/nullableReference"}, "vault_reference": {"$ref": "#/$defs/nullableReference"}, "namespace_reference": {"$ref": "#/$defs/nullableReference"}, "mount_reference": {"$ref": "#/$defs/nullableReference"}, "auth_method": {"enum": ["entra_workload_identity", "jwt", "pending"]}, "audience_reference": {"$ref": "#/$defs/nullableReference"}, "role_reference": {"$ref": "#/$defs/nullableReference"}, "secret_binding_references": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}}},
    "ai_gateway": {"type": "object", "additionalProperties": false, "required": ["state", "origin_reference", "gateway_reference", "configuration_reference", "provider", "anthropic_route_reference", "anthropic_model_reference", "direct_provider_fallback"], "properties": {"state": {"$ref": "#/$defs/state"}, "origin_reference": {"$ref": "#/$defs/nullableReference"}, "gateway_reference": {"$ref": "#/$defs/nullableReference"}, "configuration_reference": {"$ref": "#/$defs/nullableReference"}, "provider": {"const": "anthropic"}, "anthropic_route_reference": {"$ref": "#/$defs/nullableReference"}, "anthropic_model_reference": {"$ref": "#/$defs/nullableReference"}, "direct_provider_fallback": {"const": false}}},
    "packages": {"type": "object", "additionalProperties": false, "required": ["state", "repository_reference", "offline_bundle_reference", "offline_wheel_reference", "offline_jar_reference", "offline_native_reference"], "properties": {"state": {"$ref": "#/$defs/state"}, "repository_reference": {"$ref": "#/$defs/nullableReference"}, "offline_bundle_reference": {"$ref": "#/$defs/nullableReference"}, "offline_wheel_reference": {"$ref": "#/$defs/nullableReference"}, "offline_jar_reference": {"$ref": "#/$defs/nullableReference"}, "offline_native_reference": {"$ref": "#/$defs/nullableReference"}}},
    "sources": {"type": "object", "additionalProperties": false, "required": ["sas_program_state", "sas_program_reference", "sas7bdat_state", "sas7bdat_reference", "source_system_state", "source_system_reference"], "properties": {"sas_program_state": {"$ref": "#/$defs/state"}, "sas_program_reference": {"$ref": "#/$defs/nullableReference"}, "sas7bdat_state": {"$ref": "#/$defs/state"}, "sas7bdat_reference": {"$ref": "#/$defs/nullableReference"}, "source_system_state": {"$ref": "#/$defs/state"}, "source_system_reference": {"$ref": "#/$defs/nullableReference"}}},
    "probe_policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "workspace", "catalog", "volumes", "compute", "git", "vault", "ai_gateway", "packages", "sas_programs", "sas7bdat", "source_system"], "properties": {"policy_id": {"$ref": "#/$defs/reference"}, "policy_version": {"$ref": "#/$defs/reference"}, "workspace": {"$ref": "#/$defs/probe"}, "catalog": {"$ref": "#/$defs/probe"}, "volumes": {"$ref": "#/$defs/probe"}, "compute": {"$ref": "#/$defs/probe"}, "git": {"$ref": "#/$defs/optionalProbe"}, "vault": {"$ref": "#/$defs/probe"}, "ai_gateway": {"$ref": "#/$defs/probe"}, "packages": {"$ref": "#/$defs/probe"}, "sas_programs": {"$ref": "#/$defs/probe"}, "sas7bdat": {"$ref": "#/$defs/probe"}, "source_system": {"$ref": "#/$defs/probe"}}}
  },
  "$defs": {
    "state": {"enum": ["pending", "active", "denied", "not_configured"]},
    "reference": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "nullableReference": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["client_id", "deployment_id", "environment_id"], "properties": {"client_id": {"$ref": "#/$defs/reference"}, "deployment_id": {"$ref": "#/$defs/reference"}, "environment_id": {"$ref": "#/$defs/reference"}}},
    "probe": {"type": "object", "additionalProperties": false, "required": ["required", "timeout_seconds", "max_retries", "max_evidence_age_seconds", "write_scope"], "properties": {"required": {"type": "boolean"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 3}, "max_evidence_age_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000}, "write_scope": {"enum": ["none", "read_only", "scoped_internal"]}}},
    "optionalProbe": {"allOf": [{"$ref": "#/$defs/probe"}, {"properties": {"required": {"const": false}}}]}
  }
}
