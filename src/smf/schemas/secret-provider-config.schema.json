{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/secret-provider-config.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "endpoint", "tls_profile_ref", "authority", "verification_keys", "min_lease_seconds", "identity_bindings", "secret_bindings"],
  "properties": {
    "schema_version": {"const": "1.0"}, "status": {"enum": ["active", "pending", "denied"]},
    "endpoint": {"type": "string", "pattern": "^https://[^/?#]+/?$"}, "tls_profile_ref": {"$ref": "#/$defs/id"},
    "authority": {"$ref": "#/$defs/id"}, "verification_keys": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"type": "string", "minLength": 1}},
    "min_lease_seconds": {"type": "integer", "minimum": 1},
    "identity_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["binding_id", "tenant", "issuer", "audience", "authentication_flow"], "properties": {"binding_id": {"$ref": "#/$defs/id"}, "tenant": {"$ref": "#/$defs/id"}, "issuer": {"type": "string", "pattern": "^https://"}, "audience": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S+$"}, "authentication_flow": {"const": "workload_identity_federation"}}}},
    "secret_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["binding_id", "namespace", "auth_mount", "role", "engine", "path", "version"], "properties": {"binding_id": {"$ref": "#/$defs/id"}, "namespace": {"type": "string", "minLength": 1}, "auth_mount": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "engine": {"const": "kv-v2"}, "path": {"type": "string", "minLength": 1}, "version": {"$ref": "#/$defs/id"}, "previous_version": {"$ref": "#/$defs/id"}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
}
