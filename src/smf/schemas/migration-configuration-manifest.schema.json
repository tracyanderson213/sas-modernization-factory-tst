{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.local/schemas/migration-configuration-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_id", "deployment_id", "environment_id", "factory_bundle_digest", "configuration_bundle_digest", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "client_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "environment_id": {"$ref": "#/$defs/id"},
    "factory_bundle_digest": {"$ref": "#/$defs/digest"}, "configuration_bundle_digest": {"$ref": "#/$defs/digest"},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "reference", "sha256", "byte_count"], "properties": {"role": {"type": "string", "pattern": "^[A-Za-z0-9_:/.-]+$"}, "reference": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "byte_count": {"type": "integer", "minimum": 1}}}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
