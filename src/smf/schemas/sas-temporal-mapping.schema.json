{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SMF SAS Temporal Mapping Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappings"],
  "properties": {
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mapping_id", "literal_kind", "byte_start", "byte_end", "literal_sha256", "canonical_source", "normalized_value", "target_expression", "target_expression_sha256", "policy_id", "policy_version", "policy_digest", "strategy_id", "strategy_version", "plan_id", "workload_id", "source_artifact_id", "run_id", "attempt_id", "source_sha256", "generated_sha256", "registry_digest"],
        "properties": {
          "mapping_id": {"type": "string", "pattern": "^CVMAP-[0-9a-f]{16}$"},
          "literal_kind": {"enum": ["date", "datetime"]},
          "byte_start": {"type": "integer", "minimum": 0},
          "byte_end": {"type": "integer", "minimum": 1},
          "literal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "canonical_source": {"type": "string", "pattern": "^[0-9A-Z:.]+$"},
          "normalized_value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]{1,6})?$"},
          "target_expression": {"type": "string", "pattern": "^(?:DATE|TIMESTAMP) '[0-9: .-]+'$"},
          "target_expression_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "policy_id": {"type": "string"},
          "policy_version": {"type": "string"},
          "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "strategy_id": {"const": "smf.sas-temporal-literal"},
          "strategy_version": {"const": "1.0.0"},
          "plan_id": {"type": "string"},
          "workload_id": {"type": "string"},
          "source_artifact_id": {"type": "string"},
          "run_id": {"type": "string"},
          "attempt_id": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generated_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
