{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/ai-transport-policy.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "policy_digest", "status", "redirect_policy", "allowed_methods", "allowed_media_types", "providers", "max_payload_bytes", "max_response_bytes", "max_retries", "submission_authority", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"}, "policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}, "policy_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["active", "pending", "denied"]}, "redirect_policy": {"const": "reject"},
    "allowed_methods": {"type": "array", "const": ["POST"]}, "allowed_media_types": {"type": "array", "const": ["application/json"]},
    "providers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_id", "model_ids", "endpoint_binding_ids"], "properties": {"provider_id": {"$ref": "#/$defs/id"}, "model_ids": {"$ref": "#/$defs/ids"}, "endpoint_binding_ids": {"$ref": "#/$defs/ids"}}}},
    "max_payload_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}, "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760}, "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
    "submission_authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}}
  }
}
