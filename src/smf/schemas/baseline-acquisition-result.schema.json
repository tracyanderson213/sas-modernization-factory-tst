{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "baseline_result_id", "acquisition_id", "acquisition_mode", "client_id", "workload_id", "workload_revision_id", "workload_digest", "closure_digest", "boundary_id", "run_id", "attempt_id", "policy_id", "policy_version", "policy_digest", "provider", "provider_version", "source_closure", "input_snapshots", "execution", "receipt_digest", "approval_subject_digest", "approval", "outputs", "disposition", "blockers", "human_intervention", "acquired_at", "elapsed_ms", "claims", "policy_snapshot", "receipt_snapshot", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "baseline_result_id": {"$ref": "#/$defs/id"}, "acquisition_id": {"$ref": "#/$defs/id"}, "acquisition_mode": {"enum": ["approved_export", "sas_execution"]}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "workload_revision_id": {"$ref": "#/$defs/id"}, "workload_digest": {"$ref": "#/$defs/sha"}, "closure_digest": {"$ref": "#/$defs/sha"}, "boundary_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}, "policy_digest": {"$ref": "#/$defs/sha"}, "provider": {"type": "string"}, "provider_version": {"$ref": "#/$defs/id"},
    "source_closure": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["script_id", "logical_path", "sha256", "byte_count"], "properties": {"script_id": {"$ref": "#/$defs/id"}, "logical_path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "byte_count": {"type": "integer", "minimum": 1}}}},
    "input_snapshots": {"type": "array", "items": {"type": "object"}}, "execution": {"type": ["object", "null"]}, "receipt_digest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "approval_subject_digest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]}, "approval": {"type": ["object", "null"]},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["output_id", "dataset_id", "logical_name", "format", "byte_count", "content_digest", "schema_digest", "normalization_version", "artifact_uri"], "properties": {"output_id": {"$ref": "#/$defs/id"}, "dataset_id": {"$ref": "#/$defs/id"}, "logical_name": {"$ref": "#/$defs/id"}, "format": {"type": "string"}, "byte_count": {"type": "integer", "minimum": 1}, "content_digest": {"$ref": "#/$defs/sha"}, "schema_digest": {"$ref": "#/$defs/sha"}, "normalization_version": {"$ref": "#/$defs/id"}, "artifact_uri": {"type": "string", "minLength": 1}}}},
    "disposition": {"enum": ["acquired", "needs_evidence", "human_required", "blocked"]}, "blockers": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "human_intervention": {"type": "boolean"}, "acquired_at": {"type": "string", "format": "date-time"}, "elapsed_ms": {"type": "integer", "minimum": 0},
    "claims": {"type": "object", "additionalProperties": false, "required": ["baseline_acquired", "generated", "executed", "validated", "parity_passed", "certified", "human_approved"], "properties": {"baseline_acquired": {"type": "boolean"}, "generated": {"const": false}, "executed": {"const": false}, "validated": {"const": false}, "parity_passed": {"const": false}, "certified": {"const": false}, "human_approved": {"const": false}}},
    "policy_snapshot": {"type": "object"}, "receipt_snapshot": {"type": ["object", "null"]}, "content_digest": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
