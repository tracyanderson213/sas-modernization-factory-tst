{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "client_id", "batch_id", "batch_version", "batch_revision_id", "manifest_digest", "policy_id", "policy_version", "policy_digest", "run_id", "attempt_id", "expected_script_count", "observed_unique_script_count", "denominator_reconciled", "admitted_count", "blocked_count", "unprocessable_count", "unassigned_scripts", "disposition", "decisions", "manifest_snapshot", "policy_snapshot", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "result_id": {"type": "string"}, "client_id": {"type": "string"}, "batch_id": {"type": "string"}, "batch_version": {"type": "string"}, "batch_revision_id": {"type": "string"}, "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "run_id": {"type": "string"}, "attempt_id": {"type": "string"},
    "expected_script_count": {"type": "integer", "minimum": 1}, "observed_unique_script_count": {"type": "integer", "minimum": 0}, "denominator_reconciled": {"type": "boolean"}, "admitted_count": {"type": "integer", "minimum": 0}, "blocked_count": {"type": "integer", "minimum": 0}, "unprocessable_count": {"type": "integer", "minimum": 0}, "unassigned_scripts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["script_id", "reason_code"], "properties": {"script_id": {"type": "string", "minLength": 1}, "reason_code": {"const": "unmapped_inventory_script"}}}}, "disposition": {"enum": ["admitted", "partial", "blocked"]},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "manifest_snapshot": {"type": "object"}, "policy_snapshot": {"type": "object"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "telemetry": {"type": "object", "additionalProperties": false, "required": ["source_admitted", "source_snapshotted", "generated", "executed", "validated", "parity_passed", "certified", "human_assisted", "blocked"], "properties": {"source_admitted": {"type": "boolean"}, "source_snapshotted": {"type": "boolean"}, "generated": {"type": "boolean"}, "executed": {"type": "boolean"}, "validated": {"type": "boolean"}, "parity_passed": {"type": "boolean"}, "certified": {"type": "boolean"}, "human_assisted": {"type": "boolean"}, "blocked": {"type": "boolean"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["workload_alias", "workload_id", "workload_revision_id", "state", "blockers", "closure_digest", "artifact_ids", "entrypoint_artifact_ids", "snapshot_refs", "discovery", "readiness_input", "telemetry"], "properties": {"workload_alias": {"type": "string"}, "workload_id": {"type": "string"}, "workload_revision_id": {"type": ["string", "null"]}, "state": {"enum": ["admitted", "blocked"]}, "blockers": {"type": "array", "items": {"type": "string"}}, "closure_digest": {"type": ["string", "null"]}, "artifact_ids": {"type": "array", "items": {"type": "string"}}, "entrypoint_artifact_ids": {"type": "array", "items": {"type": "string"}}, "snapshot_refs": {"type": "array", "items": {"type": "object"}}, "discovery": {"type": ["object", "null"]}, "readiness_input": {"type": ["object", "null"]}, "telemetry": {"$ref": "#/$defs/telemetry"}}}
  }
}
