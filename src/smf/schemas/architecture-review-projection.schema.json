{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smf.local/architecture-review-projection.schema.json",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["client_id", "deployment_id", "environment_id", "workload_id", "subject_id", "boundary_id", "run_id", "attempt_id"],
      "properties": {
        "client_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "environment_id": {"$ref": "#/$defs/id"},
        "workload_id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "boundary_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_generated", "executed", "validated", "parity_passed", "certified", "human_approved", "human_assisted", "blocked"],
      "properties": {
        "packet_generated": {"const": true}, "executed": {"const": false}, "validated": {"const": false},
        "parity_passed": {"const": false}, "certified": {"const": false}, "human_approved": {"const": false},
        "human_assisted": {"type": "boolean"}, "blocked": {"type": "boolean"}
      }
    },
    "internalPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "packet_id", "packet_kind", "authority", "assessed_revision", "identity", "source", "configuration", "trust_boundaries", "data_flows", "controls", "risks", "endpoint_bindings", "approval_requests", "henv01_readiness", "protected_execution_decision", "evidence_handling", "blockers", "terminal_disposition", "lifecycle", "content_digest"],
      "properties": {
        "schema_version": {}, "packet_id": {}, "packet_kind": {}, "authority": {}, "assessed_revision": {},
        "identity": {}, "source": {}, "configuration": {}, "trust_boundaries": {}, "data_flows": {},
        "controls": {}, "risks": {}, "endpoint_bindings": {}, "approval_requests": {}, "henv01_readiness": {},
        "protected_execution_decision": {}, "evidence_handling": {}, "blockers": {}, "terminal_disposition": {},
        "lifecycle": {}, "content_digest": {}
      }
    },
    "sharedPayload": {
      "type": "object", "additionalProperties": false,
      "required": ["packet_kind", "authority", "assessed_revision", "identity", "source", "configuration", "approval_summary", "henv01_state", "terminal_disposition", "lifecycle"],
      "properties": {
        "packet_kind": {"const": "architecture_security_review_evidence"}, "authority": {"const": "non_authorizing"},
        "assessed_revision": {"$ref": "#/$defs/id"}, "identity": {"$ref": "#/$defs/identity"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["entry_artifact_id", "source_closure_digest", "workload_digest", "discovery_digest"],
          "properties": {
            "entry_artifact_id": {"$ref": "#/$defs/id"}, "source_closure_digest": {"$ref": "#/$defs/digest"},
            "workload_digest": {"$ref": "#/$defs/digest"}, "discovery_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "configuration": {
          "type": "object", "additionalProperties": false,
          "required": ["configuration_digest", "bundle_digest", "threat_model_digest", "requirements_digest"],
          "properties": {
            "configuration_digest": {"$ref": "#/$defs/digest"}, "bundle_digest": {"$ref": "#/$defs/digest"},
            "threat_model_digest": {"$ref": "#/$defs/digest"}, "requirements_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "approval_summary": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["requirement_refs", "decision_state"],
            "properties": {
              "requirement_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
              "decision_state": {"enum": ["approved", "pending", "denied"]}
            }
          }
        },
        "henv01_state": {"enum": ["missing", "verified", "pending", "denied"]},
        "terminal_disposition": {"enum": ["blocked", "review_ready"]}, "lifecycle": {"$ref": "#/$defs/lifecycle"}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "projection_type", "canonical_packet_id", "canonical_packet_digest", "recipient_class", "disclosure_policy_revision", "retention_policy_ref", "payload", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "projection_type": {"enum": ["controlled_internal", "shared"]},
    "canonical_packet_id": {"$ref": "#/$defs/digest"}, "canonical_packet_digest": {"$ref": "#/$defs/digest"},
    "recipient_class": {"type": ["string", "null"]}, "disclosure_policy_revision": {"type": ["string", "null"]},
    "retention_policy_ref": {"type": ["string", "null"]}, "payload": {"type": "object"}, "content_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [{
    "if": {"properties": {"projection_type": {"const": "shared"}}},
    "then": {"properties": {
      "recipient_class": {"$ref": "#/$defs/id"}, "disclosure_policy_revision": {"$ref": "#/$defs/id"},
      "retention_policy_ref": {"$ref": "#/$defs/id"}, "payload": {"$ref": "#/$defs/sharedPayload"}
    }}
  }, {
    "if": {"properties": {"projection_type": {"const": "controlled_internal"}}},
    "then": {"properties": {"payload": {"$ref": "#/$defs/internalPayload"}}}
  }]
}
