{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "selection_id", "client_id", "inventory_id", "inventory_version", "inventory_digest", "policy_id", "policy_version", "policy_digest", "run_id", "attempt_id", "evaluated_at", "full_inventory_denominator", "expected_competition_denominator", "selected_count", "excluded_count", "unprocessable_count", "coverage", "uncovered_criteria", "decisions", "blockers", "disposition", "inventory_snapshot", "policy_snapshot", "generated", "executed", "validated", "parity_passed", "certified", "human_approved", "human_assisted", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "selection_id": {"type": "string", "pattern": "^PSEL-[a-f0-9]{16}$"}, "client_id": {"type": "string"}, "inventory_id": {"type": "string"}, "inventory_version": {"type": "string"}, "inventory_digest": {"$ref": "#/$defs/digest"}, "policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "policy_digest": {"$ref": "#/$defs/digest"}, "run_id": {"type": "string"}, "attempt_id": {"type": "string"}, "evaluated_at": {"type": "string", "format": "date-time"},
    "full_inventory_denominator": {"type": "integer", "minimum": 1}, "expected_competition_denominator": {"type": "integer", "minimum": 1}, "selected_count": {"type": "integer", "minimum": 0}, "excluded_count": {"type": "integer", "minimum": 0}, "unprocessable_count": {"type": "integer", "minimum": 0},
    "coverage": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["required", "actual"], "properties": {"required": {"type": "integer"}, "actual": {"type": "integer"}}}}, "uncovered_criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["workload_id", "boundary_id", "source_closure_digest", "script_ids", "membership", "admission_state", "dimensions", "complexity_score", "reasons", "owners"], "properties": {"workload_id": {"type": "string"}, "boundary_id": {"type": "string"}, "source_closure_digest": {"$ref": "#/$defs/digest"}, "script_ids": {"type": "array", "items": {"type": "string"}}, "membership": {"enum": ["included", "excluded"]}, "admission_state": {"enum": ["eligible", "blocked", "pending", "denied"]}, "dimensions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "complexity_score": {"type": "integer"}, "reasons": {"type": "array", "items": {"type": "string"}}, "owners": {"type": "array", "items": {"type": "string"}}}}},
    "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "owner"], "properties": {"code": {"type": "string"}, "owner": {"type": "string"}}}}, "disposition": {"enum": ["qualified", "blocked", "human_required"]},
    "inventory_snapshot": {"type": "object"}, "policy_snapshot": {"type": "object"},
    "generated": {"const": false}, "executed": {"const": false}, "validated": {"const": false}, "parity_passed": {"const": false}, "certified": {"const": false}, "human_approved": {"const": false}, "human_assisted": {"const": false}, "content_digest": {"$ref": "#/$defs/digest"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
