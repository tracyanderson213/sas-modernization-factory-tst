{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.smf.example/val01-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["result_id", "schema_version", "request", "request_digest", "policy", "policy_digest", "runtime_manifest", "runtime_manifest_digest", "trust_policy", "trust_policy_digest", "prerequisite_bindings", "receipt", "status", "blockers", "claims", "content_digest"],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "snapshot_id", "snapshot_digest"], "properties": {"dataset_id": {"$ref": "#/$defs/id"}, "snapshot_id": {"$ref": "#/$defs/id"}, "snapshot_digest": {"$ref": "#/$defs/digest"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["kind", "relative_path", "result_id", "content_digest", "artifact_digest"], "properties": {"kind": {"enum": ["SCHEMA-INT-01", "DP-02", "DP-03", "DP-04", "DP-05", "DBX-04"]}, "relative_path": {"type": "string", "minLength": 1}, "result_id": {"$ref": "#/$defs/digest"}, "content_digest": {"$ref": "#/$defs/digest"}, "artifact_digest": {"$ref": "#/$defs/digest"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["client_id", "workload_id", "run_id", "attempt_id", "evaluated_at", "source", "target", "prerequisites", "policy_digest", "trust_policy_digest", "runtime_manifest_digest", "maximum_evidence_age_seconds"], "properties": {"client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "evaluated_at": {"type": "string"}, "source": {"$ref": "#/$defs/snapshot"}, "target": {"$ref": "#/$defs/snapshot"}, "prerequisites": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/binding"}}, "policy_digest": {"$ref": "#/$defs/digest"}, "trust_policy_digest": {"$ref": "#/$defs/digest"}, "runtime_manifest_digest": {"$ref": "#/$defs/digest"}, "maximum_evidence_age_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}}},
    "column": {"type": "object", "additionalProperties": false, "required": ["name", "logical_type", "coercion", "null_policy", "absolute_tolerance", "relative_tolerance", "relative_denominator", "tolerance_combination", "nan_equal", "infinity_equal", "sas_missing", "string_policy", "timezone", "yearcutoff", "encoding", "format_normalization"], "properties": {"name": {"$ref": "#/$defs/id"}, "logical_type": {"enum": ["string", "integer", "decimal", "float", "date", "timestamp", "boolean"]}, "coercion": {"enum": ["none", "source_to_target", "target_to_source"]}, "null_policy": {"enum": ["equal", "different"]}, "absolute_tolerance": {"type": "string"}, "relative_tolerance": {"type": "string"}, "relative_denominator": {"const": "target_absolute"}, "tolerance_combination": {"const": "absolute_plus_relative"}, "nan_equal": {"type": "boolean"}, "infinity_equal": {"type": "boolean"}, "sas_missing": {"enum": ["distinct", "collapse_to_null"]}, "string_policy": {"enum": ["exact", "trim", "trim_casefold"]}, "timezone": {"type": ["string", "null"]}, "yearcutoff": {"type": ["integer", "null"]}, "encoding": {"const": "utf-8"}, "format_normalization": {"const": "underlying_value_only"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "key_columns", "columns", "duplicate_policy", "tie_break_columns", "null_key_policy", "order_policy", "order_columns", "nondeterministic_exclusions", "maximum_mismatch_references"], "properties": {"policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}, "key_columns": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "columns": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/column"}}, "duplicate_policy": {"enum": ["reject", "deterministic_tiebreak"]}, "tie_break_columns": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "null_key_policy": {"enum": ["reject", "match"]}, "order_policy": {"enum": ["keyed_unordered", "ordered"]}, "order_columns": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "nondeterministic_exclusions": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "maximum_mismatch_references": {"type": "integer", "minimum": 1, "maximum": 1000}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["manifest_id", "manifest_version", "provider_id", "provider_version", "spark_version", "datacompy_version", "evidence_class", "qualified", "authority_id", "authority_digest", "verification_key_id", "verification_key", "mismatch_hmac_key_digest", "python_version", "platform_id", "distribution_records"], "properties": {"manifest_id": {"$ref": "#/$defs/id"}, "manifest_version": {"$ref": "#/$defs/id"}, "provider_id": {"$ref": "#/$defs/id"}, "provider_version": {"$ref": "#/$defs/id"}, "spark_version": {"$ref": "#/$defs/id"}, "datacompy_version": {"$ref": "#/$defs/id"}, "evidence_class": {"enum": ["synthetic_contract", "qualified_runtime"]}, "qualified": {"type": "boolean"}, "authority_id": {"$ref": "#/$defs/id"}, "authority_digest": {"$ref": "#/$defs/digest"}, "verification_key_id": {"$ref": "#/$defs/id"}, "verification_key": {"type": "string", "minLength": 1}, "mismatch_hmac_key_digest": {"$ref": "#/$defs/digest"}, "python_version": {"$ref": "#/$defs/id"}, "platform_id": {"$ref": "#/$defs/id"}, "distribution_records": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version", "record_digest"], "properties": {"name": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"}, "record_digest": {"$ref": "#/$defs/digest"}}}}}},
    "trust": {"type": "object", "additionalProperties": false, "required": ["policy_id", "policy_version", "qualified_manifest_digests", "allowed_authorities"], "properties": {"policy_id": {"$ref": "#/$defs/id"}, "policy_version": {"$ref": "#/$defs/id"}, "qualified_manifest_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "allowed_authorities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["authority_id", "authority_digest", "verification_key_id", "verification_key"], "properties": {"authority_id": {"$ref": "#/$defs/id"}, "authority_digest": {"$ref": "#/$defs/digest"}, "verification_key_id": {"$ref": "#/$defs/id"}, "verification_key": {"type": "string", "minLength": 1}}}}}},
    "claims": {"type": "object", "additionalProperties": false, "required": ["generated", "executed", "validated", "full_row_comparison_passed", "cell_parity_passed", "data_parity_passed", "certified", "human_approved", "humana_validated", "production_ready", "migration_complete"], "properties": {"generated": {"const": false}, "executed": {"const": false}, "validated": {"type": "boolean"}, "full_row_comparison_passed": {"type": "boolean"}, "cell_parity_passed": {"type": "boolean"}, "data_parity_passed": {"type": "boolean"}, "certified": {"const": false}, "human_approved": {"const": false}, "humana_validated": {"const": false}, "production_ready": {"const": false}, "migration_complete": {"const": false}}}
  },
  "properties": {
    "result_id": {"$ref": "#/$defs/digest"}, "schema_version": {"const": "1.0"}, "request": {"$ref": "#/$defs/request"}, "request_digest": {"$ref": "#/$defs/digest"}, "policy": {"$ref": "#/$defs/policy"}, "policy_digest": {"$ref": "#/$defs/digest"}, "runtime_manifest": {"$ref": "#/$defs/runtime"}, "runtime_manifest_digest": {"$ref": "#/$defs/digest"}, "trust_policy": {"$ref": "#/$defs/trust"}, "trust_policy_digest": {"$ref": "#/$defs/digest"}, "prerequisite_bindings": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/binding"}}, "receipt": {"oneOf": [{"$ref": "https://schemas.smf.example/val01-comparator-receipt.schema.json"}, {"type": "null"}]}, "status": {"enum": ["passed", "failed", "blocked", "cancelled", "unsupported"]}, "blockers": {"type": "array", "uniqueItems": true, "items": {"enum": ["cancelled_before_comparison", "cancelled_after_comparison", "comparator_runtime_unavailable", "runtime_authority_unavailable", "snapshot_authority_unavailable", "policy_unsupported", "duplicate_keys", "null_keys", "provider_failure", "independent_comparator_disagreement"]}}, "claims": {"$ref": "#/$defs/claims"}, "content_digest": {"$ref": "#/$defs/digest"}
  }
}
