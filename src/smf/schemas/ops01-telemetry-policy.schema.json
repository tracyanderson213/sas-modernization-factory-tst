{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.smf.example/ops01-telemetry-policy.schema.json","type":"object","additionalProperties":false,"required":["schema_version","policy_id","policy_version","client_id","cohort_id","authority_id","authority_digest","evaluated_at","streams"],"$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"stream":{"type":"object","additionalProperties":false,"required":["workload_id","run_id","attempt_id","source_artifact_id","source_artifact_digest"],"properties":{"workload_id":{"$ref":"#/$defs/id"},"run_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"source_artifact_id":{"$ref":"#/$defs/id"},"source_artifact_digest":{"$ref":"#/$defs/sha"}}}},"properties":{"schema_version":{"const":"1.0"},"policy_id":{"$ref":"#/$defs/id"},"policy_version":{"$ref":"#/$defs/id"},"client_id":{"$ref":"#/$defs/id"},"cohort_id":{"$ref":"#/$defs/id"},"authority_id":{"$ref":"#/$defs/id"},"authority_digest":{"$ref":"#/$defs/sha"},"evaluated_at":{"type":"string"},"streams":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/stream"}}}}
