{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/secret-resolution-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "decision_id", "request", "provider", "adapter_version", "state", "reason_code", "transport_attempted", "retryable", "elapsed_ms", "lease", "evidence_refs", "terminal_disposition", "generated", "executed", "validated", "parity_passed", "certified", "human_approved", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "resolution_id": {"$ref": "#/$defs/digest"}, "decision_id": {"type": "string", "minLength": 1},
    "request": {"$ref": "#/$defs/request"}, "provider": {"const": "hashicorp-vault"}, "adapter_version": {"const": "1.0"},
    "state": {"enum": ["resolved", "blocked_missing", "blocked_pending", "denied", "expired", "invalid_binding", "authentication_failed", "provider_unavailable", "timed_out", "cancelled", "failed"]},
    "reason_code": {"enum": ["resolved", "configuration_missing", "configuration_invalid", "configuration_pending", "approval_missing", "approval_pending", "approval_denied", "approval_expired", "activation_invalid", "binding_mismatch", "identity_rejected", "vault_denied", "credential_disabled", "credential_expired", "lease_invalid", "provider_unavailable", "transport_timeout", "cancelled", "malformed_response"]},
    "transport_attempted": {"type": "boolean"}, "retryable": {"type": "boolean"}, "elapsed_ms": {"type": "integer", "minimum": 0},
    "lease": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/lease"}]}, "evidence_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/id"}}, "terminal_disposition": {"enum": ["secret_available_transiently", "not_resolved"]},
    "generated": {"const": false}, "executed": {"const": false}, "validated": {"const": false}, "parity_passed": {"const": false}, "certified": {"const": false}, "human_approved": {"const": false},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lease": {"type": "object", "additionalProperties": false, "required": ["version", "issued_at", "expires_at", "renewable", "rotation_observed"], "properties": {"version": {"$ref": "#/$defs/id"}, "issued_at": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "minLength": 1}, "renewable": {"type": "boolean"}, "rotation_observed": {"type": "boolean"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["schema_version", "client_id", "deployment_id", "environment_id", "workload_id", "workload_digest", "boundary_id", "subject_id", "source_sha256", "run_id", "attempt_id", "consumer_id", "consumer_contract_version", "identity_binding_id", "secret_binding_id", "security_policy_id", "security_policy_version", "security_policy_digest", "configuration_digest", "readiness_result_id", "readiness_manifest_digest", "qualified_snapshot_ref", "activation_evidence_id", "activation_evidence_digest"], "properties": {"schema_version": {"const": "1.0"}, "client_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "environment_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "workload_digest": {"$ref": "#/$defs/digest"}, "boundary_id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/digest"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "consumer_id": {"$ref": "#/$defs/id"}, "consumer_contract_version": {"$ref": "#/$defs/id"}, "identity_binding_id": {"$ref": "#/$defs/id"}, "secret_binding_id": {"$ref": "#/$defs/id"}, "security_policy_id": {"$ref": "#/$defs/id"}, "security_policy_version": {"$ref": "#/$defs/id"}, "security_policy_digest": {"$ref": "#/$defs/digest"}, "configuration_digest": {"$ref": "#/$defs/digest"}, "readiness_result_id": {"$ref": "#/$defs/id"}, "readiness_manifest_digest": {"$ref": "#/$defs/digest"}, "qualified_snapshot_ref": {"type": "string", "pattern": "^evidence://"}, "activation_evidence_id": {"$ref": "#/$defs/id"}, "activation_evidence_digest": {"$ref": "#/$defs/digest"}}}
  }
}
