{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_class", "bundle_id", "client_id", "workload_id", "source_digest", "run_id", "attempt_id", "observed_at", "evaluated_at", "deployment_profile", "resolution", "installed_environment", "sbom", "licenses", "notice_files", "provenance", "upq", "sec03", "vulnerability", "authority", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_class": {"enum": ["synthetic_contract", "real"]},
    "bundle_id": {"$ref": "#/$defs/id"}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"},
    "observed_at": {"type": "string", "format": "date-time"}, "evaluated_at": {"type": "string", "format": "date-time"},
    "deployment_profile": {"type": "object", "additionalProperties": false, "required": ["profile_id", "profile_digest"], "properties": {"profile_id": {"$ref": "#/$defs/id"}, "profile_digest": {"$ref": "#/$defs/sha"}}},
    "resolution": {"$ref": "#/$defs/resolution"},
    "installed_environment": {"$ref": "#/$defs/environment"},
    "sbom": {"$ref": "#/$defs/sbom"},
    "licenses": {"type": "array", "items": {"$ref": "#/$defs/license"}},
    "notice_files": {"type": "array", "items": {"$ref": "#/$defs/notice"}},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "upq": {"$ref": "#/$defs/prerequisite"},
    "sec03": {"allOf": [{"$ref": "#/$defs/prerequisite"}, {"required": ["acceptance_contract_digest", "scope_statement"]}]},
    "vulnerability": {"$ref": "#/$defs/vulnerability"},
    "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["complete", "blocked", "pending", "denied", "failed", "ambiguous", "incompatible", "stale", "unavailable_scanner"]},
    "proof": {"type": "object", "additionalProperties": false, "required": ["algorithm", "key_id", "value"], "properties": {"algorithm": {"const": "ed25519"}, "key_id": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["component_id", "version", "artifact_type", "artifact_digest"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "artifact_type": {"enum": ["python", "wheel", "jar", "native", "application", "other"]}, "artifact_digest": {"$ref": "#/$defs/sha"}}},
    "resolution": {"type": "object", "additionalProperties": false, "required": ["resolution_id", "resolution_digest", "components"], "properties": {"resolution_id": {"$ref": "#/$defs/id"}, "resolution_digest": {"$ref": "#/$defs/sha"}, "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}}},
    "environment": {"type": "object", "additionalProperties": false, "required": ["environment_id", "environment_digest", "components"], "properties": {"environment_id": {"$ref": "#/$defs/id"}, "environment_digest": {"$ref": "#/$defs/sha"}, "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}}},
    "sbom": {"type": "object", "additionalProperties": false, "required": ["sbom_id", "sbom_digest", "format", "resolution_digest", "environment_digest", "components"], "properties": {"sbom_id": {"$ref": "#/$defs/id"}, "sbom_digest": {"$ref": "#/$defs/sha"}, "format": {"enum": ["cyclonedx-json", "spdx-json"]}, "resolution_digest": {"$ref": "#/$defs/sha"}, "environment_digest": {"$ref": "#/$defs/sha"}, "components": {"type": "array", "items": {"$ref": "#/$defs/component"}}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["component_id", "version", "artifact_type", "artifact_digest", "license_id", "license_evidence_digest", "notice_required", "source_revision", "upq_result_digest", "state", "authority", "proof"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "artifact_type": {"enum": ["python", "wheel", "jar", "native", "application", "other"]}, "artifact_digest": {"$ref": "#/$defs/sha"}, "license_id": {"$ref": "#/$defs/id"}, "license_evidence_digest": {"$ref": "#/$defs/sha"}, "notice_required": {"type": "boolean"}, "source_revision": {"type": "string", "minLength": 1}, "upq_result_digest": {"$ref": "#/$defs/sha"}, "state": {"enum": ["verified", "blocked", "pending", "denied", "failed", "ambiguous", "incompatible", "stale"]}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}}},
    "notice": {"type": "object", "additionalProperties": false, "required": ["component_id", "notice_path", "notice_digest"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "notice_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "notice_digest": {"$ref": "#/$defs/sha"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["component_id", "source_revision", "artifact_digest", "upq_result_digest"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "source_revision": {"type": "string", "minLength": 1}, "artifact_digest": {"$ref": "#/$defs/sha"}, "upq_result_digest": {"$ref": "#/$defs/sha"}}},
    "prerequisite": {"type": "object", "additionalProperties": false, "required": ["prerequisite_id", "status", "result_id", "result_digest", "client_id", "workload_id", "source_digest", "run_id", "attempt_id", "authority", "proof"], "properties": {"prerequisite_id": {"enum": ["UPQ-01", "SEC-03"]}, "status": {"$ref": "#/$defs/status"}, "result_id": {"$ref": "#/$defs/id"}, "result_digest": {"$ref": "#/$defs/sha"}, "client_id": {"$ref": "#/$defs/id"}, "workload_id": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}, "run_id": {"$ref": "#/$defs/id"}, "attempt_id": {"$ref": "#/$defs/id"}, "acceptance_contract_digest": {"$ref": "#/$defs/sha"}, "scope_statement": {"type": "string", "minLength": 1}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}}},
    "exception": {"type": "object", "additionalProperties": false, "required": ["exception_id", "advisory_id", "component_id", "expires_at", "authority", "proof"], "properties": {"exception_id": {"$ref": "#/$defs/id"}, "advisory_id": {"$ref": "#/$defs/id"}, "component_id": {"$ref": "#/$defs/id"}, "expires_at": {"type": "string", "format": "date-time"}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["finding_id", "advisory_id", "component_id", "severity", "status"], "properties": {"finding_id": {"$ref": "#/$defs/id"}, "advisory_id": {"$ref": "#/$defs/id"}, "component_id": {"$ref": "#/$defs/id"}, "severity": {"enum": ["unknown", "low", "medium", "high", "critical"]}, "status": {"enum": ["affected", "not_affected"]}, "exception_id": {"$ref": "#/$defs/id"}}},
    "advisory": {"type": "object", "additionalProperties": false, "required": ["advisory_id", "source", "source_digest"], "properties": {"advisory_id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/id"}, "source_digest": {"$ref": "#/$defs/sha"}}},
    "vulnerability": {"type": "object", "additionalProperties": false, "required": ["scanner_id", "scanner_version", "status", "scan_id", "scanned_at", "resolution_digest", "environment_digest", "sbom_digest", "advisories_digest", "advisories", "findings", "exceptions", "authority", "proof"], "properties": {"scanner_id": {"$ref": "#/$defs/id"}, "scanner_version": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/status"}, "scan_id": {"$ref": "#/$defs/id"}, "scanned_at": {"type": "string", "format": "date-time"}, "resolution_digest": {"$ref": "#/$defs/sha"}, "environment_digest": {"$ref": "#/$defs/sha"}, "sbom_digest": {"$ref": "#/$defs/sha"}, "advisories_digest": {"$ref": "#/$defs/sha"}, "advisories": {"type": "array", "items": {"$ref": "#/$defs/advisory"}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}, "authority": {"$ref": "#/$defs/id"}, "proof": {"$ref": "#/$defs/proof"}}}
  }
}
