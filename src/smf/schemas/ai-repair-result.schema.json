{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://smf.example/schemas/ai-repair-result.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","result_id","content_digest","canonical_evidence_reference","identity","status","terminal_disposition","deterministic","gateway","synthetic_exercises","blockers","implementation_manifest","claims"],
  "properties":{
    "schema_version":{"const":"1.0"},"result_id":{"$ref":"#/$defs/id"},"content_digest":{"$ref":"#/$defs/sha"},
    "canonical_evidence_reference":{"type":"string","pattern":"^runs/[A-Za-z0-9._-]+/workloads/[A-Za-z0-9._-]+/attempts/[A-Za-z0-9._-]+/ai-repair/controller\\.result\\.json$"},
    "identity":{"type":"object","additionalProperties":false,"required":["client_id","deployment_id","environment_id","workload_id","run_id","attempt_id","source_artifact_id","controller_attempt_id","policy_version","max_gateway_attempts","synthetic_scenario_plan_digest","deterministic_manifest_digest","gateway_preflight_digest","implementation_digest"],"properties":{"client_id":{"$ref":"#/$defs/id"},"deployment_id":{"$ref":"#/$defs/id"},"environment_id":{"$ref":"#/$defs/id"},"workload_id":{"$ref":"#/$defs/id"},"run_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"source_artifact_id":{"$ref":"#/$defs/id"},"controller_attempt_id":{"$ref":"#/$defs/id"},"policy_version":{"const":"1.0"},"max_gateway_attempts":{"type":"integer","minimum":1,"maximum":3},"synthetic_scenario_plan_digest":{"$ref":"#/$defs/sha"},"deterministic_manifest_digest":{"$ref":"#/$defs/sha"},"gateway_preflight_digest":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"implementation_digest":{"$ref":"#/$defs/sha"}}},
    "status":{"enum":["deterministic_complete","blocked"]},"terminal_disposition":{"enum":["deterministic_output_selected","external_gateway_authority_required"]},
    "deterministic":{"type":"object","additionalProperties":false,"required":["status","manifest_digest","source_artifact_id","source_sha256","generated_sha256","entrypoint","candidate_artifact","provider_revision","provider_license_sha256"],"properties":{"status":{"enum":["packaged","review_required","unsupported","blocked"]},"manifest_digest":{"$ref":"#/$defs/sha"},"source_artifact_id":{"$ref":"#/$defs/id"},"source_sha256":{"$ref":"#/$defs/sha"},"generated_sha256":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"entrypoint":{"type":["string","null"]},"candidate_artifact":{"type":["string","null"]},"provider_revision":{"type":"string","minLength":1},"provider_license_sha256":{"$ref":"#/$defs/sha"}}},
    "gateway":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["status","result_id","content_digest","evidence_class"],"properties":{"status":{"const":"blocked"},"result_id":{"$ref":"#/$defs/id"},"content_digest":{"$ref":"#/$defs/sha"},"evidence_class":{"const":"offline_configuration_contract"}}}]},
    "synthetic_exercises":{"type":"array","maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["ordinal","scenario","disposition","retryable","outcome_certain","evidence_class","provider_invoked","previous_attempt_digest","attempt_digest","repair_artifact_state","revalidation_state"],"properties":{"ordinal":{"type":"integer","minimum":1,"maximum":3},"scenario":{"enum":["success","authentication_denied","throttled","content_filtered","malformed","correlation_missing","disconnected","uncertain_timeout"]},"disposition":{"enum":["synthetic_success","authentication_denied","quota_throttled","content_filtered","response_contract_invalid","correlation_missing","transport_disconnected","outcome_unknown"]},"retryable":{"type":"boolean"},"outcome_certain":{"type":"boolean"},"evidence_class":{"const":"synthetic_contract"},"provider_invoked":{"const":false},"previous_attempt_digest":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"attempt_digest":{"$ref":"#/$defs/sha"},"repair_artifact_state":{"const":"not_generated"},"revalidation_state":{"const":"not_run"}}}},
    "blockers":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","state"],"properties":{"code":{"type":"string","minLength":1},"state":{"type":"string","minLength":1}}}},
    "implementation_manifest":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}}},
    "claims":{"$ref":"#/$defs/claims"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"claims":{"type":"object","additionalProperties":false,"required":["deterministic_conversion_selected","gateway_invoked","provider_invoked","repair_generated","repair_accepted","executed","validated","parity_passed","migration_ready","production_ready","migration_complete"],"properties":{"deterministic_conversion_selected":{"type":"boolean"},"gateway_invoked":{"const":false},"provider_invoked":{"const":false},"repair_generated":{"const":false},"repair_accepted":{"const":false},"executed":{"const":false},"validated":{"const":false},"parity_passed":{"const":false},"migration_ready":{"const":false},"production_ready":{"const":false},"migration_complete":{"const":false}}}},
  "allOf":[{"if":{"properties":{"status":{"const":"deterministic_complete"}}},"then":{"properties":{"terminal_disposition":{"const":"deterministic_output_selected"},"gateway":{"type":"null"},"synthetic_exercises":{"maxItems":0},"blockers":{"maxItems":0},"claims":{"properties":{"deterministic_conversion_selected":{"const":true}}}}}},{"if":{"properties":{"status":{"const":"blocked"}}},"then":{"properties":{"terminal_disposition":{"const":"external_gateway_authority_required"},"gateway":{"type":"object"},"blockers":{"minItems":1},"claims":{"properties":{"deterministic_conversion_selected":{"const":false}}}}}}]
}
