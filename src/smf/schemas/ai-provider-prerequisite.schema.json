{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smf.example/schemas/ai-provider-prerequisite.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "evidence_ref", "evidence_digest", "request_digest", "state", "issued_at", "expires_at", "proof"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"enum": ["prompt_policy", "prompt_template", "transport_policy", "configuration", "retention_policy", "access_policy"]},
    "evidence_ref": {"type": "string", "pattern": "^evidence://[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["active", "pending", "denied"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
