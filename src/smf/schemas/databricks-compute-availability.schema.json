{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "databricks-compute-availability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "authority_ref", "observed_at", "expires_at", "provider_version", "workspace_binding_id", "profile_id", "state", "quota_limit", "quota_used", "observation_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observation_id": {"$ref": "#/$defs/id"},
    "authority_ref": {"$ref": "#/$defs/id"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "provider_version": {"$ref": "#/$defs/id"},
    "workspace_binding_id": {"$ref": "#/$defs/id"},
    "profile_id": {"$ref": "#/$defs/id"},
    "state": {"enum": ["available", "pending", "denied", "quota_exhausted", "allocation_unavailable", "incompatible_runtime", "provider_unavailable"]},
    "quota_limit": {"type": "integer", "minimum": 0},
    "quota_used": {"type": "integer", "minimum": 0},
    "observation_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
